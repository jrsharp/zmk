#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        mreset: mod_reset {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_RESET";
            #binding-cells = <0>;
            bindings = <&none>, <&sys_reset>;
            mods = <(MOD_LGUI)>;
        };

        mbootloader: mod_bootloader {
            compatible = "zmk,behavior-mod-morph";
            label = "MOD_BOOTLOADER";
            #binding-cells = <0>;
            bindings = <&none>, <&bootloader>;
            mods = <(MOD_LGUI)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
// -----------------------------------------------------------------------------------------
// | EDT |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | FIL |
// | SHL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  | COM |
// | SET |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | HOM |
//                   | CTL | BSP | SPC |   | ENT | DEL  | L1  |
//
// Outer columns are app launchers (F13-F18):
//   F13=Editor  F14=Shell  F15=Settings  F16=Files  F17=Comms  F18=Home
            bindings = <
   &kp F13 &kp Q &kp W &kp E &kp R &kp T   &kp Y &kp U  &kp I     &kp O   &kp P    &kp F16
   &kp F14 &kp A &kp S &kp D &kp F &kp G   &kp H &kp J  &kp K     &kp L   &kp SEMI &kp F17
   &kp F15 &mt LSHFT Z &kp X &kp C &kp V &kp B   &kp N &kp M  &kp COMMA &kp DOT &mt RSHFT FSLH &kp F18
                       &kp LCTRL &mt LGUI BSPC &kp SPACE   &kp RET &lt 1 DEL &mo 2
            >;
        };

        number_layer {
// -----------------------------------------------------------------------------------------
// | EDT |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | FIL |
// | SHL | TAB |     |     | VOL-| VOL+|   |  <- |  v  |  ^  |  -> |  '  | COM |
// | SET |LSHFT|     |     | MUTE|     |   | HOME| END |PGUP |PGDN |RSHFT| HOM |
//                   | CTL | GUI | ALT |   | RST |     | BL  |
            bindings = <
   &kp F13 &kp N1  &kp N2 &kp N3 &kp N4       &kp N5         &kp N6   &kp N7  &kp N8    &kp N9    &kp N0    &kp F16
   &kp F14 &kp TAB &none  &none  &kp C_VOL_DN &kp C_VOL_UP   &kp LEFT &kp DOWN &kp UP   &kp RIGHT &kp SQT   &kp F17
   &kp F15 &kp LSHFT &none &none &kp C_MUTE  &none          &kp HOME &kp END &kp PG_UP &kp PG_DN &kp RSHFT &kp F18
                         &kp LCTRL &kp LGUI &kp LALT       &mreset  &trans  &mbootloader
            >;
        };

        symbol_layer {
// -----------------------------------------------------------------------------------------
// | EDT | ESC |  F1 |  F2 |  F3 |  F4 |   |     |     |     |  =  |  -  | FIL |
// | SHL |CAPS |  F5 |  F6 |  F7 |  F8 |   |  [  |  ]  |     |  `  |  \  | COM |
// | SET |LSHFT|  F9 | F10 | F11 | F12 |   |     |     |     |     |RSHFT| HOM |
//                   | CTL | GUI | ALT |   | RST |     |     |
            bindings = <
   &kp F13 &kp ESC   &kp F1 &kp F2  &kp F3  &kp F4    &none    &none    &none &kp EQUAL &kp MINUS &kp F16
   &kp F14 &kp LCTRL &kp F5 &kp F6  &kp F7  &kp F8    &kp LBKT &kp RBKT &none &kp GRAVE &kp BSLH  &kp F17
   &kp F15 &kp LSHFT &kp F9 &kp F10 &kp F11 &kp F12   &none    &none    &none &none     &kp RSHFT &kp F18
                           &kp LCTRL &kp LGUI &kp LALT   &sys_reset &none &trans
            >;
        };
    };
};
