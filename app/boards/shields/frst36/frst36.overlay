 *
 * FRST 36-key keyboard shield for RP2040 (Waveshare RP2040-Zero / rpi_pico)
 * Wired keyboard with 9P filesystem interface over UART to ESP32-S3 terminal
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zephyr,console = &uart1;
    };

    /*
     * Matrix transform for 36-key layout
     * 3 rows of 5 keys per side (30) + 3 thumb keys per side (6) = 36 total
     *
     * Physical layout:
     * | Q | W | E | R | T |   | Y | U | I | O | P |
     * | A | S | D | F | G |   | H | J | K | L | ; |
     * | Z | X | C | V | B |   | N | M | , | . | / |
     *         |CTL|BSP|SPC|   |ENT|DEL|ALT|
     *
     * Matrix wiring (4 rows x 10 columns):
     * Row 0: Q  W  E  R  T  Y  U  I  O  P
     * Row 1: A  S  D  F  G  H  J  K  L  ;
     * Row 2: Z  X  C  V  B  N  M  ,  .  /
     * Row 3: -  -  CTL BSP SPC ENT DEL ALT -  -
     */
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <10>;
        rows = <4>;
        map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4)    RC(0,5) RC(0,6) RC(0,7) RC(0,8) RC(0,9)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4)    RC(1,5) RC(1,6) RC(1,7) RC(1,8) RC(1,9)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4)    RC(2,5) RC(2,6) RC(2,7) RC(2,8) RC(2,9)
                RC(3,2) RC(3,3) RC(3,4)    RC(3,5) RC(3,6) RC(3,7)
        >;
    };

    /*
     * Key matrix scan configuration
     * Uses pico_header connector for GPIO access
     *
     * Rows: GP29, GP28, GP2, GP3 (active high with pull-down)
     * Cols: GP10, GP11, GP14, GP15, GP26, GP5, GP6, GP7, GP8, GP9 (active high)
     *
     * Note: diode-direction is col2row (diodes from column to row)
     */
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";
        debounce-press-ms = <10>;
        debounce-release-ms = <10>;

        row-gpios
            = <&gpio0 29 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pico_header 28 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pico_header 2 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            , <&pico_header 3 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>
            ;

        col-gpios
            = <&pico_header 10 GPIO_ACTIVE_HIGH>
            , <&pico_header 11 GPIO_ACTIVE_HIGH>
            , <&pico_header 14 GPIO_ACTIVE_HIGH>
            , <&pico_header 15 GPIO_ACTIVE_HIGH>
            , <&pico_header 26 GPIO_ACTIVE_HIGH>
            , <&pico_header 5 GPIO_ACTIVE_HIGH>
            , <&pico_header 6 GPIO_ACTIVE_HIGH>
            , <&pico_header 7 GPIO_ACTIVE_HIGH>
            , <&pico_header 8 GPIO_ACTIVE_HIGH>
            , <&pico_header 9 GPIO_ACTIVE_HIGH>
            ;
    };
};

/*
 * UART0 on GP0 (TX) / GP1 (RX) for 9P protocol
 * Phase 2: Echo test, Phase 3+: Full 9P server
 */
&uart0 {
    status = "okay";
    current-speed = <115200>;
};

/*
 * UART1 on GP4 (TX only) for debug console
 * Connect USB-UART adapter RX to GP4, share GND
 */
&pinctrl {
    uart1_default: uart1_default {
        group1 {
            pinmux = <UART1_TX_P4>;
        };
    };
};

&uart1 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart1_default>;
    pinctrl-names = "default";
};
